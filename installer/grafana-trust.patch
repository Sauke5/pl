+package signature
+
+import (
+ "bytes"
+ "crypto/sha256"
+ "encoding/hex"
+ "errors"
+
+ "github.com/ProtonMail/go-crypto/openpgp"
+ "github.com/ProtonMail/go-crypto/openpgp/clearsign"
+ "github.com/ProtonMail/go-crypto/openpgp/packet"
+)
+
+// Pl trust is limited to the exact signed manifests embedded by this build.
+// It does not authorize other Pl-signed plugins or change upstream trust.
+func plVerifyManifest(m PluginManifest, block *clearsign.Block) error {
+ if block == nil || m.KeyID != plSigningKeyID || m.SignedByOrg != "pl" || m.SignedByOrgName != "Pl" || string(m.SignatureType) != "community" {
+  return errors.New("invalid Pl plugin signer")
+ }
+ expected, ok := plSigningManifests[m.Plugin+"\x00"+m.Version]
+ sum := sha256.Sum256(block.Bytes)
+ if !ok || expected != hex.EncodeToString(sum[:]) {
+  return errors.New("Pl plugin manifest is outside the pinned build")
+ }
+ keys, err := openpgp.ReadArmoredKeyRing(bytes.NewBufferString(plSigningPublicKey))
+ if err != nil || len(keys) != 1 || keys[0].PrimaryKey.KeyIdString() != plSigningKeyID {
+  return errors.New("invalid embedded Pl signing key")
+ }
+ _, err = openpgp.CheckDetachedSignature(keys, bytes.NewReader(block.Bytes), block.ArmoredSignature.Body, &packet.Config{})
+ if err != nil { return errors.New("Pl plugin signature verification failed") }
+ return nil
+}
