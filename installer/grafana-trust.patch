+package signature
+
+import (
+ "bytes"
+ "context"
+ "testing"
+
+ "github.com/grafana/grafana/pkg/plugins/manager/signature/statickey"
+)
+
+func TestPlSignedPluginManifestAndTampering(t *testing.T) {
+ s := &Signature{kr: statickey.New()}
+ if _, err := s.readPluginManifest(context.Background(), []byte(plSigningFixture)); err != nil {
+  t.Fatal("pinned Pl signed manifest rejected", err)
+ }
+ for _, tc := range []struct{ old, replacement string }{
+  {`"plugin": "`, `"plugin": "foreign-`},
+  {`"version": "`, `"version": "foreign-`},
+  {`"signedByOrgName": "Pl"`, `"signedByOrgName": "Other"`},
+  {"-----BEGIN PGP SIGNATURE-----", "-----BEGIN INVALID SIGNATURE-----"},
+ } {
+  body := bytes.Replace([]byte(plSigningFixture), []byte(tc.old), []byte(tc.replacement), 1)
+  if bytes.Equal(body, []byte(plSigningFixture)) { t.Fatal("negative fixture did not change") }
+  if _, err := s.readPluginManifest(context.Background(), body); err == nil { t.Fatal("tampered manifest accepted") }
+ }
+ if _, err := s.readPluginManifest(context.Background(), []byte(`{"plugin":"unsigned"}`)); err == nil { t.Fatal("unsigned manifest accepted") }
+}
